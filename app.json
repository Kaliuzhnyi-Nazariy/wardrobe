{
  "expo": {
    "name": "wardrobe",
    "slug": "dashboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wardrobe_logo.png",
    "scheme": "wardrobe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/wardrobe_logo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nazariikl.dashboard"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D9D2C6",
          "android": {
            "image": "./assets/images/logo.png",
            "imageWidth": 350
          },
          "ios": {
            "image": "./assets/images/logo.png",
            "imageWidth": 350
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "210f0c73-4495-4624-908d-386870f793ee"
      }
    },
    "owner": "nazariikls-team"
  }
}
